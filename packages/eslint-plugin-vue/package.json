{
  "name": "@the-i18n-kit/eslint-plugin-vue",
  "version": "0.2.2",
  "description": "Authoring rules that keep the i18n kit's scanner sound, and a layer-aware preset over @intlify/eslint-plugin-vue-i18n",
  "keywords": [
    "eslint",
    "eslint-plugin",
    "i18n",
    "vue-i18n",
    "nuxt",
    "layers",
    "internationalization",
    "developer-tools"
  ],
  "author": "Fabian Kirchhoff",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabkho/the-i18n-kit.git",
    "directory": "packages/eslint-plugin-vue"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "@the-i18n-kit/cli": "workspace:^"
  },
  "peerDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^3.0.0 || ^4.0.0",
    "eslint": "^9.10.0"
  },
  "peerDependenciesMeta": {
    "@intlify/eslint-plugin-vue-i18n": {
      "optional": true
    }
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "tsdown": "^0.12.0",
    "vitest": "^3.2.0",
    "vue-eslint-parser": "^10.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
